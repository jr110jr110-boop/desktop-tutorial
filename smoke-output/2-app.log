      	                        (@bomId int)
                              RETURNS INT
                              AS
                              BEGIN
      	                        DECLARE @count INT
      	                        SET @count = (
      	                        select count(*)
      	                        from [Processes] as p
      		                        where p.BomId = @bomId and 
