                              CREATE FUNCTION [dbo].[CalculateBomProgressLevel]
      	                        (@bomId int)
                              RETURNS decimal
                              AS
                              BEGIN
      	                        DECLARE @done INT
      	                        DECLARE @all INT
      
      	                        SET @done = [dbo].[GetBomDoneProcessesCount](@bomId)
      	                        SET @all = [dbo].[GetBomProcessesCount](@bomId)
      
      	                        return 
      		                        case @all
      		                        when 0 then 0.0
      		                        else 100.0 * @done / @all
      		                        end
                              END
