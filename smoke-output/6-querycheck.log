      SELECT TOP(2) [p].[Title], [w].[ContractId], [w].[Id], [w].[Title], (
          SELECT COALESCE(SUM([p1].[ProgramPrice]), 0.0)
          FROM [Boms] AS [b0]
          INNER JOIN [Processes] AS [p1] ON [b0].[Id] = [p1].[BomId]
          WHERE [a].[Id] = [b0].[AssemblyId] AND NOT EXISTS (
              SELECT 1
              FROM [Processes] AS [p0]
              WHERE [b0].[Id] = [p0].[BomId] AND CASE
                  WHEN [p0].[ProgramEndDate] <= CAST(SYSUTCDATETIME() AS datetimeoffset) THEN CAST(0 AS bit)
                  ELSE CAST(1 AS bit)
              END = CAST(1 AS bit))), (
          SELECT COALESCE(SUM([i].[Price]), 0.0)
          FROM [BuyOrders] AS [b1]
          INNER JOIN [Inquiries] AS [i] ON [b1].[Id] = [i].[BuyOrderId]
          WHERE [w].[Id] = [b1].[WorkOrderId] AND [b1].[Deleted] = CAST(0 AS bit) AND [b1].[Status] = 100 AND [i].[IsAccept] = CAST(1 AS bit)), [p].[ProgramStartDate], [p].[ActualStartDate], [p].[ProgramEndDate], [p].[ActualEndDate], (
          SELECT COALESCE(SUM([p2].[WeightPercent]), 0.0)
          FROM [Processes] AS [p2]
          WHERE [b].[Id] = [p2].[BomId] AND [p2].[Deleted] = CAST(0 AS bit) AND [p2].[ProcessStatus] = 100), (
          SELECT COALESCE(SUM([p4].[WeightPercent]), 0.0)
          FROM [Boms] AS [b2]
          INNER JOIN [Processes] AS [p4] ON [b2].[Id] = [p4].[BomId]
          WHERE [a].[Id] = [b2].[AssemblyId] AND NOT EXISTS (
              SELECT 1
              FROM [Processes] AS [p3]
              WHERE [b2].[Id] = [p3].[BomId] AND CASE
                  WHEN [p3].[ProgramEndDate] <= CAST(SYSUTCDATETIME() AS datetimeoffset) THEN CAST(0 AS bit)
                  ELSE CAST(1 AS bit)
              END = CAST(1 AS bit))), CASE
          WHEN (
              SELECT COUNT(*)
