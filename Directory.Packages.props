<Project>
  <!--
    Central package versions for every project in this solution (NuGet Central Package Management).
    To move to a newer .NET 10 servicing release, change MicrosoftPackagesVersion in one place.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MicrosoftPackagesVersion>10.0.12</MicrosoftPackagesVersion>
  </PropertyGroup>

  <ItemGroup Label="Microsoft (.NET 10)">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.SqlServer" Version="$(MicrosoftPackagesVersion)" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Third party">
    <PackageVersion Include="AutoMapper" Version="10.1.1" />
    <PackageVersion Include="DNTPersianUtils.Core" Version="7.0.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="PersianDateTime.Core" Version="1.0.7" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="AsyncMethodNameFixer" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.11.1" />
  </ItemGroup>
</Project>
